# Mapbox public access token (starts with "pk.")
#
# This value is inlined into the built JS bundle and IS visible to anyone who
# loads the site — unavoidable for a static build with no backend.
# Protect it in the Mapbox dashboard instead:
#   Account -> Tokens -> (your token) -> URL restrictions
# and allow only the origins you deploy to, e.g.
#   https://haloman363.github.io/*
#   http://localhost:*
#
# Use a PUBLIC (pk.) token only. Never put a secret (sk.) token here.
VITE_MAPBOX_TOKEN=pk.your_token_here
