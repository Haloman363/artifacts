# Mapbox public access token (starts with "pk.") — used by the Elden Map artifact.
#
# Vite inlines VITE_* values into the built bundle, so this token IS visible to
# anyone who loads the site. That is unavoidable for a static build with no
# backend. Protect it with URL restrictions in the Mapbox dashboard instead:
#   Account -> Tokens -> (your token) -> URL restrictions
#     https://haloman363.github.io/*
#     http://localhost:*
#
# Use a PUBLIC (pk.) token only. Never put a secret (sk.) token here.
#
# For deployed builds this comes from the MAPBOX_TOKEN repository secret
# (Settings -> Secrets and variables -> Actions), see .github/workflows/deploy.yml
VITE_MAPBOX_TOKEN=pk.your_token_here
